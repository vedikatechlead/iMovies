# ---- Server ----
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---- Database ----
# Local dev replica set started by `npm run db:dev` (transactions supported):
MONGO_URI=mongodb://127.0.0.1:27017/imovies?replicaSet=rs0
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority
# auto = use transactions if the deployment supports them | on = require them | off = never
MONGO_TRANSACTIONS=auto

# ---- Web client / CORS ----
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=imovies_token
# true in production (requires HTTPS)
COOKIE_SECURE=false
PASSWORD_RESET_TTL_MINUTES=30

# ---- Booking ----
SEAT_LOCK_MINUTES=5
MAX_SEATS_PER_BOOKING=10

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_SENSITIVE_MAX=60

# ---- Payments ----
# mock = development-only simulator (no money moves; refused when NODE_ENV=production)
# razorpay = Razorpay (use rzp_test_ keys for test mode)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=dev-only-mock-payment-secret

# ---- Email (optional; without SMTP, dev mode logs emails to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IMovies <no-reply@example.com>

# ---- Scaling (optional) ----
# Set to share Socket.IO events across multiple server instances.
REDIS_URL=

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@imovies.local
# Leave empty in development to use the documented dev password; required in production.
SEED_ADMIN_PASSWORD=
